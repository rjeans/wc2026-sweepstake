---
// A team's full match history (group + knockout), used inside drill-down rows.
import { STAGE_ORDER, STAGE_BONUS, THIRD_BONUS, type TournamentData, type Stage } from '../lib/wc2026';
import { flagCode, playerColor, stageShort } from '../lib/wc2026-ui';

interface Props { country: string; data: TournamentData }
const { country, data } = Astro.props;

const ownerOf = new Map(data.teams.map((t) => [t.country, t.owner]));
const ownerColor = (c: string) => {
  const o = ownerOf.get(c);
  return o ? playerColor(o) : '#cbd5e1';
};

const team = data.teams.find((t) => t.country === country);
const reachedIdx = team ? STAGE_ORDER.indexOf(team.koReached) : 0;

const matches = data.matches
  .filter((m) => m.home === country || m.away === country)
  .sort((a, b) => a.date.localeCompare(b.date));

// The qualification (+5 R32) bonus is attributed to the last group match.
const groupMatches = matches.filter((m) => m.stage === 'GROUP');
const lastGroup = groupMatches.length ? groupMatches[groupMatches.length - 1] : null;

// Points this match contributed to the team's total:
//   group: win 3 / draw 1 / loss 0, plus +5 on the last group game if it
//   qualified; knockout: the advancement increment when the team wins.
function matchPoints(m: (typeof matches)[number]): { pts: number; qualified: boolean } | null {
  const home = m.home === country;
  const my = home ? m.homeScore : m.awayScore;
  const opp = home ? m.awayScore : m.homeScore;
  if (m.status !== 'post' || my === null || opp === null) return null;
  if (m.stage === 'GROUP') {
    let pts = my > opp ? 3 : my === opp ? 1 : 0;
    const qualified = m === lastGroup && reachedIdx >= STAGE_ORDER.indexOf('R32');
    if (qualified) pts += STAGE_BONUS.R32;
    return { pts, qualified };
  }
  const won = m.winner ? m.winner === country : my > opp;
  // Third-place play-off is a branch off the semi (not in STAGE_ORDER): the
  // winner banks the flat +20, the loser nothing.
  if (m.stage === 'THIRD') return { pts: won ? THIRD_BONUS : 0, qualified: false };
  const i = STAGE_ORDER.indexOf(m.stage);
  // Advancement (incl. penalty shootouts) is keyed off the recorded winner.
  const advanced = won && i + 1 < STAGE_ORDER.length;
  return { pts: advanced ? STAGE_BONUS[STAGE_ORDER[i + 1]] - STAGE_BONUS[m.stage] : 0, qualified: false };
}

const fmtDate = (iso: string) => {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00Z');
  return Number.isNaN(d.getTime())
    ? iso
    : new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(d);
};
---

<div class="tm">
  {matches.length === 0 ? (
    <p class="tm-empty">No matches yet.</p>
  ) : (
    matches.map((m) => {
      const home = m.home === country;
      const my = home ? m.homeScore : m.awayScore;
      const opp = home ? m.awayScore : m.homeScore;
      const oppName = home ? m.away : m.home;
      const played = my !== null && opp !== null;
      // Knockout ties level after 90/120 are decided on penalties: show W/L by
      // the recorded winner with a "pens" marker rather than a misleading draw.
      let res = '';
      let pens = false;
      if (played) {
        const mh = my as number, oh = opp as number;
        if (mh > oh) res = 'W';
        else if (mh < oh) res = 'L';
        else if (m.stage !== 'GROUP' && m.winner) { res = m.winner === country ? 'W' : 'L'; pens = true; }
        else res = 'D';
      }
      const tag = m.group ? m.group : stageShort(m.stage as Stage);
      const mp = matchPoints(m);
      return (
        <div class={`tm-row${played ? '' : ' tm-future'}`}>
          <span class="tm-tag">{tag}</span>
          <span class="tm-date">{fmtDate(m.date)}</span>
          <span class="tm-opp">
            <span class="tm-vs">v</span>
            {flagCode(oppName) && (
              <img class="flag" src={`https://flagcdn.com/w40/${flagCode(oppName)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(oppName)}.png 2x`} width="18" height="13" alt="" loading="lazy" />
            )}
            <span class="tm-name">{oppName}</span>
            <span class="owner-dot" style={`background-color:${ownerColor(oppName)}`}></span>
          </span>
          <span class={`tm-score${m.status === 'in' ? ' live' : ''}`}>{played ? `${my} - ${opp}` : '—'}</span>
          {res && <span class={`tm-res tm-${res}`}>{res}{pens && <small>p</small>}</span>}
          {mp && (
            <span class={`tm-pts${mp.pts === 0 ? ' nil' : ''}`}>
              +{mp.pts}{mp.qualified && <small>R32</small>}
            </span>
          )}
        </div>
      );
    })
  )}
</div>

<style>
  .tm { background: #fbfcfd; border-top: 1px solid #eef2f6; padding: 0.15rem 0; }
  .tm-empty { margin: 0; padding: 0.5rem 0.85rem 0.5rem 1.7rem; font-size: 0.82rem; color: #94a3b8; }
  .tm-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0.85rem 0.32rem 1.7rem;
    font-size: 0.82rem;
    border-bottom: 1px solid #f4f6f9;
    color: #475569;
  }
  .tm-row:last-child { border-bottom: none; }
  .tm-row.tm-future { color: #94a3b8; }
  .tm-tag {
    flex: none;
    min-width: 1.5rem;
    text-align: center;
    padding: 0.05rem 0.3rem;
    border-radius: 5px;
    font-size: 0.6rem;
    font-weight: 800;
    color: #475569;
    background: #eef2f6;
  }
  .tm-date { flex: none; min-width: 2.8rem; font-size: 0.72rem; color: #94a3b8; }
  .tm-opp { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 0; flex: 1; }
  .tm-vs { color: #cbd5e1; font-size: 0.72rem; }
  .tm-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .owner-dot { width: 7px; height: 7px; border-radius: 999px; flex: none; }
  .tm-score { flex: none; font-weight: 700; color: #0f172a; }
  .tm-score.live { color: #dc2626; }
  .tm-res {
    flex: none;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
  }
  .tm-W { background: #dcfce7; color: #15803d; }
  .tm-D { background: #fef9c3; color: #a16207; }
  .tm-L { background: #fee2e2; color: #b91c1c; }
  .tm-pts { flex: none; min-width: 2.2rem; text-align: right; font-weight: 800; font-size: 0.78rem; color: #0f766e; }
  .tm-pts.nil { color: #cbd5e1; }
  .tm-pts small { font-size: 0.52rem; font-weight: 800; color: #0e7490; margin-left: 0.1rem; vertical-align: super; }
</style>
