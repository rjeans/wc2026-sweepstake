---
import Layout from '../layouts/WC2026Layout.astro';
import { getTournamentData, stageLabel } from '../lib/wc2026';
import { playerColor, stageStyle, stageShort, tierStyle, flagCode, fmtSigned, MEDALS } from '../lib/wc2026-ui';

const data = getTournamentData();
const hasScores = data.status === 'in-progress' || data.status === 'complete';

// Podium display order: 2nd, 1st, 3rd (winner centre).
const podium = hasScores ? [data.players[1], data.players[0], data.players[2]] : [];

// Per-team points breakdown: for each player, their six teams ordered by the
// points they contribute. Bars are scaled against the single biggest team
// contribution anywhere, so they're comparable across players.
const breakdown = data.players.map((p) => ({
  player: p,
  teams: [...p.teams].sort((a, b) => b.points - a.points || a.tier - b.tier),
}));
const maxTeamPoints = Math.max(
  1,
  ...data.players.flatMap((p) => p.teams.map((t) => t.points)),
);
---

<Layout title="Overall Table" active="table">
  {!hasScores && (
    <p class="lead">
      The table goes live with the first kick-off on <strong>Thursday 11 June 2026</strong>.
      Until then everyone sits level on zero.
    </p>
  )}

  {hasScores && (
    <div class="podium">
      {podium.map((p, i) => {
        const place = i === 1 ? 1 : i === 0 ? 2 : 3;
        return (
          <div class={`podium-card place-${place}`} style={`--accent:${playerColor(p.name)}`}>
            <span class="medal" style={`background-color:${MEDALS[place - 1]}`}>{place}</span>
            <span class="podium-name">{p.name}</span>
            <span class="podium-pts">{p.points}<small>pts</small></span>
            <span class="podium-meta">{stageLabel(p.best)} &middot; GD {fmtSigned(p.gd)}</span>
          </div>
        );
      })}
    </div>
  )}

  <section>
    <div class="section-head">
      <h2 class="label">{hasScores ? 'Overall Table' : 'Players'}</h2>
      <span class="count">8 players, 6 teams each</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="num">#</th>
            <th>Player</th>
            <th class="num">Pld</th>
            <th class="num">Points</th>
            <th class="num">GD</th>
            <th class="num">GF</th>
            <th>Best Run</th>
            <th class="num">Teams</th>
          </tr>
        </thead>
        <tbody>
          {data.players.map((p) => (
            <tr class={hasScores && p.rank <= 3 ? 'top' : ''}>
              <td class="num rank">{p.rank}</td>
              <td class="nowrap">
                <span class="chip" style={`--accent:${playerColor(p.name)}`}>
                  <span class="chip-dot"></span>{p.name}
                </span>
              </td>
              <td class="num">{p.played}</td>
              <td class="num strong">{p.points}</td>
              <td class="num">{fmtSigned(p.gd)}</td>
              <td class="num">{p.gf}</td>
              <td class="nowrap"><span class="badge" style={stageStyle(p.best)}>{stageLabel(p.best)}</span></td>
              <td class="num">{p.teams.length === 0 ? <span class="muted">&mdash;</span> : p.teams.length}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {hasScores && (
    <section>
      <div class="section-head">
        <h2 class="label">Points by team</h2>
        <span class="count">where each player's total comes from</span>
      </div>
      <div class="breakdown">
        {breakdown.map(({ player, teams }) => {
          const through = teams.filter((t) => t.koReached !== 'GROUP').length;
          return (
          <div class="bd-card" style={`--accent:${playerColor(player.name)}`}>
            <div class="bd-head">
              <span class="chip" style={`--accent:${playerColor(player.name)}`}>
                <span class="chip-dot"></span>{player.name}
              </span>
              <span class="bd-meta">
                {through > 0 && <span class="bd-through">{through} in KO</span>}
                <span class="bd-total">{player.points}<small>pts</small></span>
              </span>
            </div>
            <ul class="bd-teams">
              {teams.map((t) => (
                <li class={`bd-team${t.points === 0 ? ' zero' : ''}`}>
                  <span class="tier-dot" style={tierStyle(t.tier)}>{t.tier}</span>
                  {flagCode(t.country) && (
                    <img class="flag" src={`https://flagcdn.com/w40/${flagCode(t.country)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(t.country)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                  )}
                  <span class="bd-name">{t.country}</span>
                  {t.koReached !== 'GROUP' && (
                    <span class="ko-badge" style={stageStyle(t.koReached)}>{stageShort(t.koReached)}</span>
                  )}
                  <span class="bd-bar">
                    <span class="bd-fill" style={`width:${(t.points / maxTeamPoints) * 100}%;background-color:${playerColor(player.name)}`}></span>
                  </span>
                  <span class="bd-pts">{t.points}</span>
                </li>
              ))}
            </ul>
          </div>
          );
        })}
      </div>
    </section>
  )}
</Layout>

<style>
  .breakdown {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .bd-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--accent);
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    padding: 0.85rem 1rem 0.95rem;
  }
  .bd-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.55rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .bd-meta { display: inline-flex; align-items: baseline; gap: 0.5rem; }
  .bd-through {
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #0e7490;
    background: #cffafe;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
  }
  .bd-total { font-size: 1.25rem; font-weight: 800; color: var(--accent); }
  .bd-total small { font-size: 0.65rem; font-weight: 600; color: #94a3b8; margin-left: 0.15rem; }
  .bd-teams { list-style: none; margin: 0; padding: 0; }
  .ko-badge {
    flex: none;
    padding: 0.05rem 0.35rem;
    border-radius: 5px;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .bd-team {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.28rem 0;
  }
  .bd-team.zero { opacity: 0.55; }
  .bd-name {
    flex: none;
    width: 6.5rem;
    font-size: 0.85rem;
    color: #0f172a;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .bd-bar {
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: #f1f5f9;
    overflow: hidden;
  }
  .bd-fill { display: block; height: 100%; border-radius: 999px; min-width: 2px; }
  .bd-pts { font-weight: 800; color: #0f172a; font-size: 0.9rem; text-align: right; min-width: 1.6rem; }
  @media (max-width: 640px) {
    .breakdown { grid-template-columns: 1fr; }
  }
</style>
