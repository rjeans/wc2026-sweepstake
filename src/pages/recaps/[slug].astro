---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/WC2026Layout.astro';
import { getTournamentData } from '../../lib/wc2026';
import { playerColor, flagCode } from '../../lib/wc2026-ui';

export async function getStaticPaths() {
  const posts = await getCollection('recaps');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const data = getTournamentData();

const teamByCountry = new Map(data.teams.map((t) => [t.country, t]));
const ownerColor = (country: string) => {
  const owner = teamByCountry.get(country)?.owner;
  return owner ? playerColor(owner) : '#cbd5e1';
};
const ownerName = (country: string) => teamByCountry.get(country)?.owner ?? null;

const toIso = (d: Date) => d.toISOString().slice(0, 10);
const todayIso = toIso(post.data.pubDate);
const yesterdayIso = toIso(new Date(post.data.pubDate.getTime() - 86_400_000));

const matchesOn = (iso: string) =>
  data.matches.filter((m) => m.date === iso).sort((a, b) => a.stage.localeCompare(b.stage));

const yesterdayMatches = matchesOn(yesterdayIso);
const todayMatches = matchesOn(todayIso);

const fmtFullDate = (iso: string) => {
  const d = new Date(iso + 'T00:00:00Z');
  return new Intl.DateTimeFormat('en-GB', {
    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  }).format(d);
};
---

<Layout title={post.data.title} active="recaps">
  <article class="recap-article">
    <header class="recap-head">
      <p class="label">Daily Recap</p>
      <h1 class="recap-title">{post.data.title}</h1>
      <p class="recap-date">{fmtFullDate(todayIso)}</p>
    </header>

    {yesterdayMatches.length > 0 && (
      <section class="recap-section">
        <h2 class="recap-section-head">Yesterday's results</h2>
        <div class="table-wrap">
          {yesterdayMatches.map((m) => {
            const played = m.homeScore !== null && m.awayScore !== null;
            const homeWin = played && (m.homeScore as number) > (m.awayScore as number);
            const awayWin = played && (m.awayScore as number) > (m.homeScore as number);
            const homeOwner = ownerName(m.home);
            const awayOwner = ownerName(m.away);
            return (
              <div class="match">
                <span class={`match-side home${homeWin ? ' win' : ''}`}>
                  <span class="recap-owner">{homeOwner}</span>
                  <span class="match-name">{m.home}</span>
                  <span class="owner-dot" style={`background-color:${ownerColor(m.home)}`}></span>
                  {flagCode(m.home) && (
                    <img class="flag" src={`https://flagcdn.com/w40/${flagCode(m.home)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(m.home)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                  )}
                </span>
                <span class="match-score">{played ? `${m.homeScore} - ${m.awayScore}` : 'v'}</span>
                <span class={`match-side away${awayWin ? ' win' : ''}`}>
                  {flagCode(m.away) && (
                    <img class="flag" src={`https://flagcdn.com/w40/${flagCode(m.away)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(m.away)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                  )}
                  <span class="owner-dot" style={`background-color:${ownerColor(m.away)}`}></span>
                  <span class="match-name">{m.away}</span>
                  <span class="recap-owner">{awayOwner}</span>
                </span>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <section class="recap-body prose">
      <Content />
    </section>

    {todayMatches.length > 0 && (
      <section class="recap-section">
        <h2 class="recap-section-head">Today's fixtures</h2>
        <div class="table-wrap">
          {todayMatches.map((m) => {
            const played = m.homeScore !== null && m.awayScore !== null;
            const homeWin = played && (m.homeScore as number) > (m.awayScore as number);
            const awayWin = played && (m.awayScore as number) > (m.homeScore as number);
            const homeOwner = ownerName(m.home);
            const awayOwner = ownerName(m.away);
            return (
              <div class="match">
                <span class={`match-side home${homeWin ? ' win' : ''}`}>
                  <span class="recap-owner">{homeOwner}</span>
                  <span class="match-name">{m.home}</span>
                  <span class="owner-dot" style={`background-color:${ownerColor(m.home)}`}></span>
                  {flagCode(m.home) && (
                    <img class="flag" src={`https://flagcdn.com/w40/${flagCode(m.home)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(m.home)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                  )}
                </span>
                <span class="match-score">{played ? `${m.homeScore} - ${m.awayScore}` : 'v'}</span>
                <span class={`match-side away${awayWin ? ' win' : ''}`}>
                  {flagCode(m.away) && (
                    <img class="flag" src={`https://flagcdn.com/w40/${flagCode(m.away)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(m.away)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                  )}
                  <span class="owner-dot" style={`background-color:${ownerColor(m.away)}`}></span>
                  <span class="match-name">{m.away}</span>
                  <span class="recap-owner">{awayOwner}</span>
                </span>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <nav class="recap-foot-nav">
      <a href="/recaps">&larr; All recaps</a>
    </nav>
  </article>
</Layout>

<style>
  /* Tighten the match grid for recaps - no date column, more room for names. */
  .recap-article :global(.match) { grid-template-columns: 1fr auto 1fr; }
  @media (max-width: 520px) {
    .recap-article :global(.match) { grid-template-columns: 1fr auto 1fr; }
  }

  .recap-article { max-width: 720px; margin: 0 auto; }
  .recap-head { margin-bottom: 2rem; }
  .recap-title {
    margin: 0.4rem 0 0.3rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #0f172a;
    line-height: 1.2;
  }
  .recap-date { margin: 0; font-size: 0.9rem; color: #64748b; }

  .recap-section { margin: 2rem 0; }
  .recap-section-head {
    margin: 0 0 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #0f766e;
  }
  .recap-owner {
    font-size: 0.72rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0.4rem;
  }
  .match-side.home .recap-owner { order: -1; }

  .recap-body {
    font-size: 1rem;
    color: #1e293b;
    line-height: 1.65;
    margin: 2rem 0;
  }
  .recap-body :global(p) { margin: 0 0 1.1rem; }
  .recap-body :global(strong) { color: #0f172a; }
  .recap-body :global(h2),
  .recap-body :global(h3) {
    margin: 1.6rem 0 0.5rem;
    font-weight: 700;
    color: #0f172a;
  }
  .recap-body :global(h2) { font-size: 1.2rem; }
  .recap-body :global(h3) { font-size: 1.05rem; }
  .recap-body :global(ul) { margin: 0 0 1.1rem; padding-left: 1.3rem; }
  .recap-body :global(li) { margin-bottom: 0.3rem; }
  .recap-body :global(a) { color: #0d9488; }

  .recap-foot-nav {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
    font-size: 0.9rem;
  }
  .recap-foot-nav a { color: #0d9488; text-decoration: none; font-weight: 600; }
  .recap-foot-nav a:hover { text-decoration: underline; }
</style>
