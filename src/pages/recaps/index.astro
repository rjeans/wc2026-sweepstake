---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/WC2026Layout.astro';

const posts = await getCollection('recaps');
posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(d);
---

<Layout title="Recaps" active="recaps">
  <section>
    <div class="section-head">
      <h2 class="label">Daily Recaps</h2>
      <span class="count">
        {posts.length === 0 ? 'Starting soon' : `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`}
      </span>
    </div>

    {posts.length === 0 ? (
      <p class="lead">
        The first recap lands once the tournament kicks off on
        <strong>Thursday 11 June 2026</strong>. A new one will appear each morning &mdash;
        yesterday's goals, today's fixtures, and gentle teasing all round.
      </p>
    ) : (
      <div class="recap-list">
        {posts.map((post) => (
          <article class="recap-card">
            <p class="recap-card-date">{fmtDate(post.data.pubDate)}</p>
            <h3 class="recap-card-title">
              <a href={`/recaps/${post.slug}`}>{post.data.title}</a>
            </h3>
            {post.data.summary && (
              <p class="recap-card-summary">{post.data.summary}</p>
            )}
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  .recap-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .recap-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #0d9488;
    border-radius: 14px;
    padding: 1.1rem 1.3rem;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
  }
  .recap-card-date {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #64748b;
  }
  .recap-card-title {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .recap-card-title a {
    color: #0f172a;
    text-decoration: none;
  }
  .recap-card-title a:hover {
    color: #0d9488;
  }
  .recap-card-summary {
    margin: 0;
    color: #475569;
    font-size: 0.92rem;
  }
</style>
