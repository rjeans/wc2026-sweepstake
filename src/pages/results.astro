---
import Layout from '../layouts/WC2026Layout.astro';
import { getTournamentData, stageLabel, STAGE_ORDER, type Stage } from '../lib/wc2026';
import { playerColor, tierStyle, stageStyle, flagCode } from '../lib/wc2026-ui';

const data = getTournamentData();
const hasScores = data.status === 'in-progress' || data.status === 'complete';

// Look up a team's owner/flag by country for the match list.
const teamByCountry = new Map(data.teams.map((t) => [t.country, t]));

// Group matches by stage, in tournament order; within a stage, by date.
const matchesByStage = STAGE_ORDER.map((stage) => ({
  stage,
  matches: data.matches
    .filter((m) => m.stage === stage)
    .sort((a, b) => a.date.localeCompare(b.date)),
})).filter((g) => g.matches.length > 0);

// Team records table: order by points, then GD, then GF, then FIFA rank.
const teamsSorted = [...data.teams].sort((a, b) => {
  if (b.groupPoints !== a.groupPoints) return b.groupPoints - a.groupPoints;
  const aGD = a.gf - a.ga;
  const bGD = b.gf - b.ga;
  if (bGD !== aGD) return bGD - aGD;
  if (b.gf !== a.gf) return b.gf - a.gf;
  return a.fifa_rank - b.fifa_rank;
});

const fmtDate = (iso: string) => {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00Z');
  return Number.isNaN(d.getTime())
    ? iso
    : new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(d);
};
const ownerColor = (country: string) => {
  const owner = teamByCountry.get(country)?.owner;
  return owner ? playerColor(owner) : '#cbd5e1';
};
---

<Layout title="Results" active="results">
  {/* MATCH BY MATCH */}
  <section>
    <div class="section-head">
      <h2 class="label">Matches</h2>
      <span class="count">{data.matches.length > 0 ? `${data.matches.length} played` : 'Fixtures'}</span>
    </div>

    {matchesByStage.length === 0 ? (
      <p class="lead">
        No matches played yet. Match-by-match results appear here once the tournament
        kicks off on <strong>Thursday 11 June 2026</strong>. The coloured dot by each
        team shows its owner.
      </p>
    ) : (
      <div class="matches">
        {matchesByStage.map((g) => (
          <div class="match-stage">
            <h3 class="match-stage-head">{stageLabel(g.stage as Stage)}</h3>
            <div class="table-wrap">
              {g.matches.map((m) => {
                const played = m.homeScore !== null && m.awayScore !== null;
                const homeWin = played && (m.homeScore as number) > (m.awayScore as number);
                const awayWin = played && (m.awayScore as number) > (m.homeScore as number);
                return (
                  <div class="match">
                    <span class="match-date">{fmtDate(m.date)}</span>
                    <span class={`match-side home${homeWin ? ' win' : ''}`}>
                      <span class="match-name">{m.home}</span>
                      <span class="owner-dot" style={`background-color:${ownerColor(m.home)}`}></span>
                      {flagCode(m.home) && (
                        <img class="flag" src={`https://flagcdn.com/w40/${flagCode(m.home)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(m.home)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                      )}
                    </span>
                    <span class="match-score">{played ? `${m.homeScore} - ${m.awayScore}` : 'v'}</span>
                    <span class={`match-side away${awayWin ? ' win' : ''}`}>
                      {flagCode(m.away) && (
                        <img class="flag" src={`https://flagcdn.com/w40/${flagCode(m.away)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(m.away)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                      )}
                      <span class="owner-dot" style={`background-color:${ownerColor(m.away)}`}></span>
                      <span class="match-name">{m.away}</span>
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  {/* TEAM RECORDS */}
  <section>
    <div class="section-head">
      <h2 class="label">Team Records</h2>
      <span class="count">48 teams, ordered by Pts, GD, GF</span>
    </div>
    {!hasScores && (
      <p class="lead">Aggregate win/draw/loss records fill in as results are synced.</p>
    )}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="num">#</th>
            <th>Country</th>
            <th>Grp</th>
            <th class="num">FIFA</th>
            <th>Owner</th>
            <th class="num">Pld</th>
            <th class="num">W</th>
            <th class="num">D</th>
            <th class="num">L</th>
            <th class="num">GF</th>
            <th class="num">GA</th>
            <th class="num">Pts</th>
            <th>Stage</th>
          </tr>
        </thead>
        <tbody>
          {teamsSorted.map((t, i) => (
            <tr>
              <td class="num rank">{i + 1}</td>
              <td class="nowrap strong">
                <span class="team">
                  <span class="tier-dot" style={tierStyle(t.tier)}>{t.tier}</span>
                  {flagCode(t.country) && (
                    <img class="flag" src={`https://flagcdn.com/w40/${flagCode(t.country)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(t.country)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                  )}
                  {t.country}
                </span>
              </td>
              <td><span class="group">{t.group}</span></td>
              <td class="num">{t.fifa_rank}</td>
              <td class="nowrap">
                {t.owner ? (
                  <span class="chip" style={`--accent:${playerColor(t.owner)}`}>
                    <span class="chip-dot"></span>{t.owner}
                  </span>
                ) : (
                  <span class="muted">&mdash;</span>
                )}
              </td>
              <td class="num">{t.gw + t.gd + t.gl}</td>
              <td class="num">{t.gw}</td>
              <td class="num">{t.gd}</td>
              <td class="num">{t.gl}</td>
              <td class="num">{t.gf}</td>
              <td class="num">{t.ga}</td>
              <td class="num strong">{t.groupPoints}</td>
              <td class="nowrap"><span class="badge" style={stageStyle(t.stage)}>{stageLabel(t.stage)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
