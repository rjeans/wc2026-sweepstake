---
import Layout from '../../layouts/WC2026Layout.astro';
import {
  getTournamentData,
  stageLabel,
  PLAYERS,
  playerSlug,
  type Stage,
} from '../../lib/wc2026';
import { playerColor, tierStyle, stageStyle, fmtSigned, flagCode } from '../../lib/wc2026-ui';
import PlayerPills from '../../components/PlayerPills.astro';

export async function getStaticPaths() {
  return PLAYERS.map((p) => ({ params: { player: playerSlug(p) }, props: { player: p } }));
}

interface Props { player: string }
const { player } = Astro.props;
const data = getTournamentData();

const teamByCountry = new Map(data.teams.map((t) => [t.country, t]));
const ownerColor = (country: string) => {
  const o = teamByCountry.get(country)?.owner;
  return o ? playerColor(o) : '#cbd5e1';
};

const playerRow = data.players.find((p) => p.name === player);

// This player's teams, ordered by points contributed (then strength tier).
const ownedTeams = [...data.teams.filter((t) => t.owner === player)].sort(
  (a, b) => b.points - a.points || a.tier - b.tier,
);

// All matches a given team appears in, chronological.
const matchesOf = (country: string) =>
  data.matches
    .filter((m) => m.home === country || m.away === country)
    .sort((a, b) => a.date.localeCompare(b.date));

// What one match contributes to the owning team's table columns. Group stage:
// win 3 / draw 1 / loss 0, and the goals it scored/conceded. Only completed
// (status 'post') matches count, matching the standings the table is built from.
const contribution = (country: string, m: (typeof data.matches)[number]) => {
  const isHome = m.home === country;
  const myScore = isHome ? m.homeScore : m.awayScore;
  const oppScore = isHome ? m.awayScore : m.homeScore;
  const opponent = isHome ? m.away : m.home;
  const hasScore = myScore !== null && oppScore !== null;
  const counted = m.status === 'post' && hasScore;
  const result = !counted ? '' : myScore! > oppScore! ? 'W' : myScore === oppScore ? 'D' : 'L';
  const pts = counted && m.stage === 'GROUP' ? (myScore! > oppScore! ? 3 : myScore === oppScore ? 1 : 0) : 0;
  return {
    opponent,
    myScore,
    oppScore,
    hasScore,
    live: m.status === 'in',
    counted,
    result,
    pld: counted ? 1 : 0,
    pts,
    gf: counted ? (myScore as number) : 0,
    gd: counted ? (myScore as number) - (oppScore as number) : 0,
  };
};

const fmtDate = (iso: string) => {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00Z');
  return Number.isNaN(d.getTime())
    ? iso
    : new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(d);
};
---

<Layout title={`${player}'s Team Scores`} active="results">
  <PlayerPills active={player} />

  {/* TABLE LEVEL — this player's standings row */}
  {playerRow && (
    <section class="player-summary" style={`--accent:${playerColor(player)}`}>
      <div class="ps-name">
        <span class="ps-dot"></span>{player}
        <span class="ps-rank">#{playerRow.rank}</span>
      </div>
      <div class="ps-stats">
        <span><strong>{playerRow.points}</strong> pts</span>
        <span>{playerRow.played} played</span>
        <span>GD {fmtSigned(playerRow.gd)}</span>
        <span>GF {playerRow.gf}</span>
        <span>{stageLabel(playerRow.best)}</span>
      </div>
    </section>
  )}

  {/* DRILL — every team's contribution to each column; expand for the matches */}
  <section>
    <div class="section-head">
      <h2 class="label">Breakdown by team</h2>
      <span class="count">tap a team for its matches</span>
    </div>

    <div class="drill">
      <div class="drill-grid drill-head">
        <span>Team</span>
        <span class="num">Pld</span>
        <span class="num">Pts</span>
        <span class="num">GD</span>
        <span class="num">GF</span>
      </div>

      {ownedTeams.map((t) => {
        const teamGd = t.gf - t.ga;
        const teamMatches = matchesOf(t.country);
        const bonus = t.points - t.groupPoints; // progression bonus, 0 during groups
        return (
          <details class="drill-team">
            <summary class="drill-grid drill-row">
              <span class="drill-name">
                <span class="chev"></span>
                <span class="tier-dot" style={tierStyle(t.tier)}>{t.tier}</span>
                {flagCode(t.country) && (
                  <img class="flag" src={`https://flagcdn.com/w40/${flagCode(t.country)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(t.country)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                )}
                <span class="dn-text">{t.country}</span>
                {t.stage !== 'GROUP' && (
                  <span class="badge" style={stageStyle(t.stage)}>{stageLabel(t.stage)}</span>
                )}
              </span>
              <span class="num">{t.gw + t.gd + t.gl}</span>
              <span class="num strong">{t.points}</span>
              <span class="num">{fmtSigned(teamGd)}</span>
              <span class="num">{t.gf}</span>
            </summary>

            <div class="drill-matches">
              {teamMatches.map((m) => {
                const c = contribution(t.country, m);
                return (
                  <div class={`drill-grid drill-match${c.counted ? '' : ' future'}`}>
                    <span class="dm-info">
                      <span class="dm-date">{fmtDate(m.date)}</span>
                      <span class="dm-vs">v</span>
                      {flagCode(c.opponent) && (
                        <img class="flag" src={`https://flagcdn.com/w40/${flagCode(c.opponent)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(c.opponent)}.png 2x`} width="18" height="13" alt="" loading="lazy" />
                      )}
                      <span class="dm-opp">{c.opponent}</span>
                      <span class="owner-dot" style={`background-color:${ownerColor(c.opponent)}`}></span>
                      <span class={`dm-score${c.live ? ' live' : ''}`}>
                        {c.hasScore ? `${c.myScore}-${c.oppScore}` : '—'}
                      </span>
                      {c.result && <span class={`res res-${c.result}`}>{c.result}</span>}
                      {c.live && <span class="res res-live">LIVE</span>}
                    </span>
                    <span class="num">{c.counted ? c.pld : ''}</span>
                    <span class="num strong">{c.counted ? `+${c.pts}` : ''}</span>
                    <span class="num">{c.counted ? fmtSigned(c.gd) : ''}</span>
                    <span class="num">{c.counted ? c.gf : ''}</span>
                  </div>
                );
              })}
              {bonus > 0 && (
                <div class="drill-grid drill-match bonus">
                  <span class="dm-info">Reached {stageLabel(t.stage)} &mdash; progression bonus</span>
                  <span class="num"></span>
                  <span class="num strong">+{bonus}</span>
                  <span class="num"></span>
                  <span class="num"></span>
                </div>
              )}
            </div>
          </details>
        );
      })}

      {playerRow && (
        <div class="drill-grid drill-total">
          <span>Total</span>
          <span class="num">{playerRow.played}</span>
          <span class="num strong">{playerRow.points}</span>
          <span class="num">{fmtSigned(playerRow.gd)}</span>
          <span class="num">{playerRow.gf}</span>
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  /* TABLE LEVEL */
  .player-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.75rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--accent);
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
  }
  .ps-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    color: #0f172a;
    font-size: 1.05rem;
  }
  .ps-dot { width: 10px; height: 10px; border-radius: 999px; background: var(--accent); }
  .ps-rank {
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    background: var(--accent);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
  }
  .ps-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    color: #475569;
    font-size: 0.9rem;
  }
  .ps-stats strong { color: #0f172a; font-size: 1.1rem; font-weight: 800; }

  /* DRILL */
  .drill {
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
  }
  .drill-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.8rem 3rem 3rem 2.8rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
  }
  .drill-head {
    background: #f8fafc;
    border-bottom: 2px solid #e2e8f0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
  }
  .drill-team { border-bottom: 1px solid #f1f5f9; }
  .drill-team:last-of-type { border-bottom: none; }
  summary.drill-row { cursor: pointer; list-style: none; }
  summary.drill-row::-webkit-details-marker { display: none; }
  summary.drill-row:hover { background: #f8fafc; }
  .drill-team[open] > summary.drill-row { background: #f1f5f9; }
  .drill-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    font-weight: 600;
    color: #0f172a;
  }
  .dn-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .chev {
    width: 0; height: 0; flex: none;
    border-left: 5px solid #94a3b8;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    transition: transform 0.15s ease;
  }
  .drill-team[open] > summary .chev { transform: rotate(90deg); }

  .drill-matches { background: #fbfcfd; border-top: 1px solid #eef2f6; }
  .drill-match {
    padding-left: 1.7rem;
    font-size: 0.82rem;
    border-bottom: 1px solid #f4f6f9;
    color: #475569;
  }
  .drill-match:last-child { border-bottom: none; }
  .drill-match.future { color: #94a3b8; }
  .dm-info { display: inline-flex; align-items: center; gap: 0.4rem; min-width: 0; }
  .dm-date { font-size: 0.72rem; color: #94a3b8; min-width: 2.8rem; flex: none; }
  .dm-vs { color: #cbd5e1; font-size: 0.72rem; }
  .dm-opp { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .owner-dot { width: 7px; height: 7px; border-radius: 999px; flex: none; }
  .dm-score { font-weight: 700; color: #0f172a; flex: none; }
  .dm-score.live { color: #dc2626; }
  .res {
    font-size: 0.62rem;
    font-weight: 800;
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    flex: none;
  }
  .res-W { background: #dcfce7; color: #15803d; }
  .res-D { background: #fef9c3; color: #a16207; }
  .res-L { background: #fee2e2; color: #b91c1c; }
  .res-live { background: #fee2e2; color: #dc2626; }
  .bonus .dm-info { font-style: italic; color: #a16207; }

  .drill-total {
    background: #ecfdf5;
    border-top: 2px solid #e2e8f0;
    font-weight: 800;
    color: #0f172a;
  }

  @media (max-width: 520px) {
    .drill-grid { grid-template-columns: minmax(0, 1fr) 2.2rem 2.6rem 2.6rem 2.2rem; gap: 0.25rem; padding: 0.5rem 0.55rem; }
    .drill-match { padding-left: 1rem; }
  }
</style>
