---
import Layout from '../../layouts/WC2026Layout.astro';
import {
  getTournamentData,
  stageLabel,
  STAGE_ORDER,
  PLAYERS,
  playerSlug,
  type Stage,
} from '../../lib/wc2026';
import { playerColor, tierStyle, stageStyle, flagCode } from '../../lib/wc2026-ui';
import PlayerPills from '../../components/PlayerPills.astro';

export async function getStaticPaths() {
  return PLAYERS.map((p) => ({ params: { player: playerSlug(p) }, props: { player: p } }));
}

interface Props { player: string }
const { player } = Astro.props;
const data = getTournamentData();

const teamByCountry = new Map(data.teams.map((t) => [t.country, t]));
const ownerOf = (country: string) => teamByCountry.get(country)?.owner ?? null;
const ownerColor = (country: string) => {
  const o = ownerOf(country);
  return o ? playerColor(o) : '#cbd5e1';
};

// Filter to this player's six teams.
const ownedTeams = data.teams.filter((t) => t.owner === player);
const ownedSet = new Set(ownedTeams.map((t) => t.country));

// Filter to matches that involve any of those teams.
const playerMatches = data.matches.filter(
  (m) => ownedSet.has(m.home) || ownedSet.has(m.away),
);
const matchesByStage = STAGE_ORDER.map((stage) => ({
  stage,
  matches: playerMatches
    .filter((m) => m.stage === stage)
    .sort((a, b) => a.date.localeCompare(b.date)),
})).filter((g) => g.matches.length > 0);

// Order the player's teams by points, then GD, then GF, then FIFA rank.
const teamsSorted = [...ownedTeams].sort((a, b) => {
  if (b.groupPoints !== a.groupPoints) return b.groupPoints - a.groupPoints;
  const aGD = a.gf - a.ga;
  const bGD = b.gf - b.ga;
  if (bGD !== aGD) return bGD - aGD;
  if (b.gf !== a.gf) return b.gf - a.gf;
  return a.fifa_rank - b.fifa_rank;
});

const playerStandings = data.players.find((p) => p.name === player);
const played = playerMatches.filter((m) => m.status === 'post' || m.status === 'in').length;
const total = playerMatches.length;

const fmtDate = (iso: string) => {
  if (!iso) return '';
  const d = new Date(iso + 'T00:00:00Z');
  return Number.isNaN(d.getTime())
    ? iso
    : new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(d);
};
---

<Layout title={`${player}'s results`} active="results">
  <PlayerPills active={player} />

  {playerStandings && (
    <section class="player-summary" style={`--accent:${playerColor(player)}`}>
      <div class="ps-name">
        <span class="ps-dot"></span>{player}
      </div>
      <div class="ps-stats">
        <span><strong>{playerStandings.points}</strong> pts</span>
        <span>{playerStandings.played} played</span>
        <span>GD {playerStandings.gd > 0 ? `+${playerStandings.gd}` : playerStandings.gd}</span>
        <span>GF {playerStandings.gf}</span>
        <span>Rank #{playerStandings.rank}</span>
      </div>
    </section>
  )}

  {/* MATCH BY MATCH */}
  <section>
    <div class="section-head">
      <h2 class="label">Matches</h2>
      <span class="count">{played} of {total} played</span>
    </div>

    {matchesByStage.length === 0 ? (
      <p class="lead">No matches yet for {player}'s six teams.</p>
    ) : (
      <div class="matches">
        {matchesByStage.map((g) => (
          <div class="match-stage">
            <h3 class="match-stage-head">{stageLabel(g.stage as Stage)}</h3>
            <div class="table-wrap">
              {g.matches.map((m) => {
                const playedM = m.homeScore !== null && m.awayScore !== null;
                const homeWin = playedM && (m.homeScore as number) > (m.awayScore as number);
                const awayWin = playedM && (m.awayScore as number) > (m.homeScore as number);
                return (
                  <div class="match">
                    <span class="match-date">{fmtDate(m.date)}</span>
                    <span class={`match-side home${homeWin ? ' win' : ''}`}>
                      <span class="match-name">{m.home}</span>
                      <span class="owner-dot" style={`background-color:${ownerColor(m.home)}`}></span>
                      {flagCode(m.home) && (
                        <img class="flag" src={`https://flagcdn.com/w40/${flagCode(m.home)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(m.home)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                      )}
                    </span>
                    <span class="match-score">{playedM ? `${m.homeScore} - ${m.awayScore}` : 'v'}</span>
                    <span class={`match-side away${awayWin ? ' win' : ''}`}>
                      {flagCode(m.away) && (
                        <img class="flag" src={`https://flagcdn.com/w40/${flagCode(m.away)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(m.away)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                      )}
                      <span class="owner-dot" style={`background-color:${ownerColor(m.away)}`}></span>
                      <span class="match-name">{m.away}</span>
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  {/* TEAM RECORDS */}
  <section>
    <div class="section-head">
      <h2 class="label">Squad records</h2>
      <span class="count">{ownedTeams.length} teams, ordered by Pts, GD, GF</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th class="num">#</th>
            <th>Country</th>
            <th>Grp</th>
            <th class="num">FIFA</th>
            <th class="num">Pld</th>
            <th class="num">W</th>
            <th class="num">D</th>
            <th class="num">L</th>
            <th class="num">GF</th>
            <th class="num">GA</th>
            <th class="num">Pts</th>
            <th>Stage</th>
          </tr>
        </thead>
        <tbody>
          {teamsSorted.map((t, i) => (
            <tr>
              <td class="num rank">{i + 1}</td>
              <td class="nowrap strong">
                <span class="team">
                  <span class="tier-dot" style={tierStyle(t.tier)}>{t.tier}</span>
                  {flagCode(t.country) && (
                    <img class="flag" src={`https://flagcdn.com/w40/${flagCode(t.country)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(t.country)}.png 2x`} width="20" height="14" alt="" loading="lazy" />
                  )}
                  {t.country}
                </span>
              </td>
              <td><span class="group">{t.group}</span></td>
              <td class="num">{t.fifa_rank}</td>
              <td class="num">{t.gw + t.gd + t.gl}</td>
              <td class="num">{t.gw}</td>
              <td class="num">{t.gd}</td>
              <td class="num">{t.gl}</td>
              <td class="num">{t.gf}</td>
              <td class="num">{t.ga}</td>
              <td class="num strong">{t.groupPoints}</td>
              <td class="nowrap"><span class="badge" style={stageStyle(t.stage)}>{stageLabel(t.stage)}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<style>
  .player-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.75rem;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--accent);
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
  }
  .ps-name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    color: #0f172a;
    font-size: 1.05rem;
  }
  .ps-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--accent);
  }
  .ps-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    color: #475569;
    font-size: 0.9rem;
  }
  .ps-stats strong { color: #0f172a; font-size: 1.1rem; font-weight: 800; }
</style>
