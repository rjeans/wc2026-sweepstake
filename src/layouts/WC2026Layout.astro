---
import { getTournamentData } from '../lib/wc2026';
import { STATUS_META, flagCode } from '../lib/wc2026-ui';

interface Props {
  title: string;
  active: 'teams' | 'table' | 'odds' | 'results' | 'fixtures' | 'recaps' | 'rules';
}

const { title, active } = Astro.props;
const { status, updatedAt, liveMatches } = getTournamentData();
const sm = STATUS_META[status];

const nav = [
  { key: 'teams', label: 'Teams', href: '/' },
  { key: 'table', label: 'Overall Table', href: '/table' },
  { key: 'results', label: 'Results', href: '/results' },
  { key: 'fixtures', label: 'Fixtures', href: '/fixtures' },
  { key: 'odds', label: 'Odds', href: '/odds' },
  { key: 'recaps', label: 'Recaps', href: '/recaps' },
  { key: 'rules', label: 'Rules', href: '/rules' },
] as const;

const updatedLabel = updatedAt
  ? new Intl.DateTimeFormat('en-GB', {
      day: 'numeric', month: 'long', year: 'numeric',
      hour: '2-digit', minute: '2-digit',
      timeZone: 'Europe/London', timeZoneName: 'short',
    }).format(new Date(updatedAt))
  : null;

const hosts = [
  ['United States', 'USA'],
  ['Canada', 'Canada'],
  ['Mexico', 'Mexico'],
] as const;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Family World Cup 2026 sweepstake - allocation and live standings." />
    <meta name="theme-color" content="#0b2a4a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://flagcdn.com" />
    <title>{title} - Extended Jeans Universe WC26 Sweepstake</title>
  </head>
  <body>
    <header class="hero">
      <div class="wrap">
        <div class="hero-row">
          <p class="eyebrow">North America 2026</p>
          <span class="status">
            <span class={`dot${sm.live ? ' dot-live' : ''}`} style={`background-color:${sm.dot}`}></span>
            {sm.label}
          </span>
        </div>
        <a href="/" class="title">Extended Jeans Universe<br /><span class="title-sub">WC26 Sweepstake</span></a>
        <div class="hosts">
          {hosts.map(([c, label]) => (
            <span class="host">
              <img class="flag" src={`https://flagcdn.com/w40/${flagCode(c)}.png`} srcset={`https://flagcdn.com/w80/${flagCode(c)}.png 2x`} width="22" height="15" alt="" loading="lazy" />
              {label}
            </span>
          ))}
          <span class="kick">Kick-off 11 June 2026</span>
        </div>
      </div>
    </header>

    <nav class="nav">
      <div class="wrap nav-inner">
        {nav.map((n) => (
          <a href={n.href} class={n.key === active ? 'active' : ''} aria-current={n.key === active ? 'page' : undefined}>
            {n.label}
          </a>
        ))}
      </div>
    </nav>

    {liveMatches.length > 0 && (
      <div class="live-banner">
        <div class="wrap live-banner-inner">
          <span class="live-dot"></span>
          <span class="live-tag">In play</span>
          <div class="live-list">
            {liveMatches.map((m) => (
              <span class="live-match">
                {m.home} <strong>{m.homeScore ?? 0}-{m.awayScore ?? 0}</strong> {m.away}
              </span>
            ))}
          </div>
        </div>
      </div>
    )}

    <main class="wrap body">
      <slot />
      <footer class="foot">
        {updatedLabel && <p class="updated">Last updated {updatedLabel}</p>}
        <a href="https://jeansy.org">jeansy.org</a>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: #eef2f6;
    color: #0f172a;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .wrap { max-width: 880px; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem; }

  /* HERO */
  .hero {
    position: relative;
    color: #fff;
    padding: 2.5rem 0 2.25rem;
    background: linear-gradient(125deg, #0b2a4a 0%, #0d5e63 55%, #0f9b6c 100%);
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 88% -30%, rgba(255, 255, 255, 0.22), transparent 55%);
    pointer-events: none;
  }
  .hero-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }
  .dot { width: 8px; height: 8px; border-radius: 999px; display: inline-block; }
  .dot-live { animation: pulse 1.6s infinite; }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(52, 211, 153, 0); }
    100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); }
  }
  .title {
    position: relative;
    display: inline-block;
    margin: 0.85rem 0 0.6rem;
    font-size: clamp(1.7rem, 5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: #fff;
    text-decoration: none;
  }
  .title-sub { color: rgba(255, 255, 255, 0.88); }
  .hosts {
    position: relative;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.94);
  }
  .host { display: inline-flex; align-items: center; gap: 0.45rem; }
  .kick {
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
  }

  /* NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid #e2e8f0;
  }
  .nav-inner { display: flex; gap: 0.25rem; overflow-x: auto; }
  .nav a {
    padding: 0.9rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #64748b;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover { color: #0f172a; }
  .nav a.active { color: #0f766e; border-bottom-color: #0f766e; }

  /* LIVE BANNER */
  .live-banner {
    background: linear-gradient(90deg, #dc2626 0%, #b91c1c 100%);
    color: #fff;
    box-shadow: 0 2px 8px rgba(220, 38, 38, 0.18);
  }
  .live-banner-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }
  .live-banner .live-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: #fef2f2;
    animation: pulse 1.6s infinite;
  }
  .live-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .live-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.85rem;
    font-size: 0.85rem;
  }
  .live-match strong { font-weight: 800; padding: 0 0.15rem; }
  @media (max-width: 520px) {
    .live-banner-inner { font-size: 0.8rem; gap: 0.4rem 0.7rem; }
  }

  /* FLAGS */
  .flag {
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.12);
    object-fit: cover;
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }

  /* BODY */
  .body { padding-top: 2.25rem; padding-bottom: 3rem; }
  .body > section { margin-bottom: 2.5rem; }

  .label {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #64748b;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e2e8f0;
  }
  .count { font-size: 0.78rem; color: #94a3b8; }
  .lead { font-size: 0.95rem; color: #475569; margin: 0 0 1.5rem; }

  /* CALLOUT */
  .callout {
    border-radius: 14px;
    padding: 1.25rem 1.4rem;
    margin-bottom: 2rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-left: 4px solid #0d9488;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
  }
  .callout-lead { margin: 0.6rem 0 0; font-size: 1.05rem; color: #0f172a; }
  .callout-text { margin: 0.6rem 0 0; font-size: 0.9rem; color: #475569; }

  /* RULES TYPOGRAPHY */
  .prose { font-size: 0.92rem; color: #475569; }
  .prose > div { margin-bottom: 1.6rem; }
  .prose h3 { margin-bottom: 0.5rem; }
  .prose ul { margin: 0; padding-left: 1.2rem; }
  .prose li { margin-bottom: 0.3rem; }
  .prose p { margin: 0 0 0.7rem; }
  .scoring { margin: 0.4rem 0 0.8rem; border-collapse: collapse; }
  .scoring td { padding: 0.2rem 0; }
  .scoring td:first-child { padding-right: 1.5rem; }
  .scoring td:last-child { text-align: right; color: #0f172a; }
  .fineprint { font-size: 0.8rem; color: #94a3b8; }

  /* PODIUM */
  .podium {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    align-items: end;
    margin-bottom: 2.5rem;
  }
  .podium-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1.1rem 0.75rem;
    border-radius: 14px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-top: 4px solid var(--accent);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
    text-align: center;
  }
  .place-1 { padding-top: 1.6rem; padding-bottom: 1.6rem; }
  .medal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    color: #fff;
    font-weight: 800;
    font-size: 0.85rem;
  }
  .podium-name { font-weight: 700; color: #0f172a; margin-top: 0.2rem; }
  .podium-pts { font-size: 1.6rem; font-weight: 800; color: var(--accent); }
  .podium-pts small { font-size: 0.7rem; font-weight: 600; color: #94a3b8; margin-left: 0.15rem; }
  .podium-meta { font-size: 0.74rem; color: #94a3b8; }

  /* TABLES */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
  }
  table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  thead th {
    text-align: left;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
    background: #f8fafc;
    padding: 0.6rem 0.7rem;
    border-bottom: 2px solid #e2e8f0;
    white-space: nowrap;
  }
  tbody td {
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid #f1f5f9;
    color: #475569;
  }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:nth-child(even) { background: #fafbfc; }
  tbody tr:hover { background: #f1f5f9; }
  .num { text-align: right; }
  .nowrap { white-space: nowrap; }
  .strong { color: #0f172a; font-weight: 600; }
  .muted { color: #cbd5e1; }
  .rank { color: #94a3b8; }
  .top td { background: #fffbeb; }
  .top:hover td { background: #fef3c7; }

  .team { display: inline-flex; align-items: center; gap: 0.5rem; }

  /* MATCHES */
  .match-stage { margin-bottom: 1.75rem; }
  .match-stage-head {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0f766e;
  }
  .match {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto 1fr;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid #f1f5f9;
  }
  .match:last-child { border-bottom: none; }
  .match:nth-child(even) { background: #fafbfc; }
  .match-date { font-size: 0.72rem; color: #94a3b8; white-space: nowrap; }
  .match-side {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    color: #475569;
    font-weight: 500;
  }
  .match-side.home { justify-content: flex-end; text-align: right; }
  .match-side.away { justify-content: flex-start; text-align: left; }
  .match-side.win { color: #0f172a; font-weight: 700; }
  .match-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .owner-dot { width: 8px; height: 8px; border-radius: 999px; flex: none; }
  .match-score {
    font-weight: 800;
    color: #0f172a;
    font-size: 0.95rem;
    min-width: 3.2rem;
    text-align: center;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .match { grid-template-columns: 2.6rem 1fr auto 1fr; gap: 0.35rem; padding: 0.55rem 0.5rem; }
    .match-name { font-size: 0.8rem; }
  }

  /* CHIPS & BADGES */
  .chip { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; color: #0f172a; }
  .chip-dot { width: 9px; height: 9px; border-radius: 999px; background: var(--accent); flex: none; }
  .badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .tier-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    font-size: 0.68rem;
    font-weight: 700;
    flex: none;
  }
  .group {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    padding: 0.1rem 0.35rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #475569;
    background: #f1f5f9;
  }

  /* FOOTER */
  .foot {
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
    text-align: center;
    font-size: 0.8rem;
  }
  .foot a { color: #0d9488; text-decoration: none; font-weight: 600; }
  .foot a:hover { text-decoration: underline; }
  .updated { margin: 0 0 0.6rem; color: #94a3b8; font-size: 0.78rem; }

  @media (max-width: 520px) {
    .hero { padding: 2rem 0; }
    .body { padding-top: 1.75rem; }
    .podium-pts { font-size: 1.3rem; }
  }
</style>
